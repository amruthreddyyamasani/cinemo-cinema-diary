# Optional server-side movie provider configuration.
# Prefer a TMDB v4 read token in the server environment.
TMDB_READ_TOKEN=
# TMDB_API_KEY is supported as a fallback for local development.
TMDB_API_KEY=
# Never commit production secrets or expose them as VITE_ variables.

# Browser-safe Supabase project values. These are publishable, not service-role secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
